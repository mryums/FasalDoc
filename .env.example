# FasalDoc backend configuration template. Copy this file to .env for local use.
# Keep provider keys blank or as placeholders to use mock mode.

DASHSCOPE_API_KEY=your_key_here
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_VISION_MODEL=qwen-vl-plus
DASHSCOPE_TEXT_MODEL=qwen-plus
DASHSCOPE_ASR_MODEL=qwen3-asr-flash
DASHSCOPE_TTS_MODEL=qwen3-tts-flash
DASHSCOPE_TTS_VOICE=Cherry
DASHSCOPE_TIMEOUT_SECONDS=60
DASHSCOPE_MAX_RETRIES=2
DASHSCOPE_TTS_MAX_LENGTH=1500
DASHSCOPE_CONFIDENCE_THRESHOLD=60

# Optional Gemini fallback when DashScope is not configured.
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.6-flash

# Optional legacy alias for the text model. Prefer DASHSCOPE_TEXT_MODEL.
DASHSCOPE_MODEL=

BACKEND_PORT=8000
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://localhost:8000
