# ---------------------------------------------------------------------------
# FasalDoc backend configuration — TEMPLATE ONLY (no real secrets here).
# Copy to `.env` and fill in values locally. `.env` is gitignored.
# ---------------------------------------------------------------------------

# --- AI provider (Member 1: Qwen / Alibaba Cloud DashScope) ----------------
# Leave blank or keep the placeholder to run fully offline on mock responses.
# When a real key is present, the backend attempts to load Member 1's Qwen
# provider and otherwise falls back to the offline mock automatically.
DASHSCOPE_API_KEY=your_key_here
DASHSCOPE_BASE_URL=
DASHSCOPE_MODEL=

# --- Backend server (Member 2) ---------------------------------------------
# Port the FastAPI app listens on: uvicorn backend.main:app --port 8000
BACKEND_PORT=8000

# Comma-separated origins allowed by CORS. Defaults to the Vite dev server.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Base URL of the FasalDoc FastAPI backend (Member 2).
# Never put AI/cloud credentials here — all secrets stay server-side.
VITE_API_BASE_URL=http://localhost:8000
